{# @prop company_name Company display name #}
{# @prop company_initials Company avatar initials #}
{# @prop member_count Number of members in the company #}
{# @prop users_route URL to the users list page, null if not accessible #}
{% props company_name = '', company_initials = '?', member_count = 0, users_route = null %}

<div class="px-3 py-2 border-t border-sidebar-border shrink-0">
    {% if users_route %}
        <a
            href="{{ users_route }}"
            class="w-full flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-sidebar-accent transition-colors text-left group"
        >
    {% else %}
        <div class="w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-left">
    {% endif %}

        <div class="size-10 rounded-full bg-primary/15 text-primary flex items-center justify-center text-sm font-bold shrink-0">
            {{ company_initials }}
        </div>
        <div class="flex flex-col min-w-0 flex-1">
            <span class="text-sm font-semibold text-sidebar-foreground truncate">{{ company_name }}</span>
            <span class="text-xs text-sidebar-foreground/60 truncate">
                {{ member_count }} {{ member_count > 1 ? 'members'|trans : 'member'|trans }}
            </span>
        </div>
        {% if users_route %}
            <twig:ux:icon name="lucide:chevron-right" class="size-4 text-sidebar-foreground/40 shrink-0 opacity-0 group-hover:opacity-100 transition-opacity"/>
        {% endif %}

    {% if users_route %}
        </a>
    {% else %}
        </div>
    {% endif %}
</div>
